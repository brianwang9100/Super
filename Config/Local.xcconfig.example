// Copy this file to Config/Local.xcconfig and fill in your own values.
// Config/Local.xcconfig is gitignored — your team ID never lands in git.
//
// Find your Apple Developer team ID at:
//   https://developer.apple.com/account → Membership Details → Team ID

DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Set a profile only for local Release archives; Debug uses Automatic signing.
// TestFlight CI supplies the profile from a secret.
//
// PROVISIONING_PROFILE_SPECIFIER = Your Profile Name

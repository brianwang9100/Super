{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/block-outside-worktree.sh",
            "statusMessage": "Checking write path is inside the worktree"
          }
        ]
      },
      {
        "matcher": "exec_command|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/enforce-snapshot-sim.sh",
            "statusMessage": "Checking iOS sim destination matches the pinned CI trio"
          }
        ]
      }
    ]
  }
}
